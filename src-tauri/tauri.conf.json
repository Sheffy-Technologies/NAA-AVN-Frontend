  "productName": "naavn-ddbmsAVN",
  "version": "0.2.8",
  "identifier": "com.naavn.ddbms",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AVN",
        "width": 800,
        "height": 600,
        "resizable": true,
